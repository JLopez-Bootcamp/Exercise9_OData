<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="sapips.training.odata.controller.Main">
    <Page id="page" title="{i18n>title}">

        <VBox id="vbox1" class="sapUiSmallMarginTop sapUiSmallMarginBottom">

            <Title id="tabtitleProduct" text="{i18n>tableTitle}" level="H2" wrapping="false" class="sapUiTinyMarginBegin"/>
            <HBox id="hboxDivider" class="customDivider"/>
            <Text id="textProductDescription" text="{i18n>descProductTable}" class="textStyle sapUiTinyMarginBegin"/>

        </VBox>

        <Table id="tabProduct" items="{path: '/Products',
                               sorter: { path: 'ProductName' },
                               filters: [{ path: 'Discontinued', 
                               operator: 'EQ', 
                               value1: false }]             }">

        <columns>
            <Column id="column1">
                <Text id="textColProduct" text="{i18n>colProduct}"/>
            </Column>
            <Column id="column2">
                <Text id="textColSupplierID" text="{i18n>colSupplierId}"/>
            </Column>
            <Column id="column3">
                <Text id="textColPrice" text="{i18n>colPrice}"/>
            </Column>
        </columns>

        <items>
            <ColumnListItem id="cliProduct">
                <cells>
                    <ObjectIdentifier id="oiProduct" title="{ProductName}" text="{i18n>lblProductID}: {ProductID}"/>

                    <Text id="textSupplierID" text="{SupplierID}"/>

                    <ObjectIdentifier id="onPrice" title="{UnitPrice}" text="{QuantityPerUnit}"/>
                </cells>
            </ColumnListItem>
        </items>

        </Table>


    <content/>
    </Page>
</mvc:View>