<mvc:View controllerName="sapips.training.odata.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
        <Table id="tabProduct" 
            items="{
            path: '/Products',
            sorter: { path: 'ProductName' },
            filters: [{ path: 'Discontinued', operator: 'EQ', value1: false }]
            }" >
        <headerToolbar>
            <OverflowToolbar id="oft1">
                <Text id="textProductsTitle" text="{i18n>tabTitle}" />
            </OverflowToolbar>
        </headerToolbar>

        <columns>
            <Column id="column1">
                <Text id="textColProduct" text="{i18n>colProduct}" />
            </Column>
            <Column id="column2">
                <Text id="textColSupplierID" text="{i18n>colSupplierId}" />
            </Column>
            <Column id="column3">
                <Text id="textColPrice" text="{i18n>colPrice}" />
            </Column>
        </columns>

        <items>
            <ColumnListItem id="cliProduct">
                <cells>
                    <ObjectIdentifier id="oiProduct" title="{ProductName}" text="{ProductName}"/>

                    <Text id="textSupplierID" text="{SupplierID}" />

                    <ObjectIdentifier id="onPrice"  title="{UnitPrice}" text="{QuantityPerUnit}" />
                </cells>
            </ColumnListItem>
        </items>

        </Table>
    </Page>
</mvc:View>